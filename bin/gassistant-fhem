#!/usr/bin/env node

//
// This executable sets up the environment and runs the gassistant-fhem CLI.
//

'use strict';

const PROCESS_TITLE = 'fhem-connect';

process.title = PROCESS_TITLE;

const path = require('path');
const fs = require('fs');
const { execFileSync } = require('child_process');
const lib = path.join(path.dirname(fs.realpathSync(__filename)), '../lib');

// Running instances show up as "fhem-connect" (process.title) or, while starting
// or where the title can't be set, as "node .../gassistant-fhem ...".
function findOtherInstances() {
  if (process.platform === 'win32')
    return [];

  let out;
  try {
    out = execFileSync('ps', ['-eo', 'pid=,args='], { encoding: 'utf8' });
  } catch (err) {
    return [];
  }

  return out.split('\n').map(function (line) {
    const m = line.trim().match(/^(\d+)\s+(.*)$/);
    return m ? { pid: parseInt(m[1]), args: m[2] } : undefined;
  }).filter(function (p) {
    if (!p || p.pid === process.pid)
      return false;
    if (p.args.trim() === PROCESS_TITLE)
      return true;
    return /^\S*node(js)?\s+\S*gassistant-fhem(\s|$)/.test(p.args);
  });
}

const others = findOtherInstances();
if (others.length > 0) {
  others.forEach(function (p) {
    console.log("###############################################################");
    console.log("Another gassistant-fhem process is running!");
    console.log('PID: %s, COMMAND: %s', p.pid, p.args);
    console.log("###############################################################");
  });
} else {
  require(lib + '/cli')();
}
